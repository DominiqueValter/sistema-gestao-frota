PS C:\Users\dominique.valter\source\repos\sistema-gestao-frota> cd C:\Users\dominique.valter\source\repos\sistema-gestao-frota; Set-Content -Path .env.example
>> # Exemplo de variáveis de ambiente para uso local / CI
>> # Copie para .env e customize sem commitar credenciais reais
>>
>> POSTGRES_IMAGE=postgres:16
>> POSTGRES_CONTAINER=fleet_postgres
>> POSTGRES_USER=fleetuser
>> POSTGRES_PASSWORD=fleetpass123
>> POSTGRES_DB=fleet_db
>> POSTGRES_PORT=5432
>> POSTGRES_VOLUME=postgres_data
>> -Value @'
>> # A aplicação .NET pode obter a connection string via variável de ambiente
>> # Nome: ConnectionStrings__DefaultConnection
>> # Exemplo:
>> # ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=fleet_db;Username=fleetuser;Password=fleetpass123
>>
>> '@ -Encoding UTF8; git add .gitignore .env.example; git commit -m "Move .env.example para a raiz e adiciona .env ao .gitignore"; git push -u origin chore/move-env-and-gitignore
